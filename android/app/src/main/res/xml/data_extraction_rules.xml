<?xml version="1.0" encoding="utf-8"?>
<!-- 학습 기록·북마크·여행 계획은 기기 안에만 둔다 (PRD §10.4). 구매 권한은 스토어 복원으로 되살린다 (FR25). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
