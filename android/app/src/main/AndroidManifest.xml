<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 장소 사진(TourAPI·Wikimedia)을 내려받는다 (Phase 14). 리뷰·경로 API 도 이 권한을 쓴다. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup=false 만으로는 Android 12+ 의 기기 간 이전을 막지 못한다. 학습 기록·여행 계획은
      기기 안에만 두므로(PRD §10.4) dataExtractionRules 로 클라우드 백업과 기기 이전을 모두 제외한다.
      앱별 언어 목록(localeConfig)은 AGP 가 values-xx/ 에서 자동으로 만든다(generateLocaleConfig).
      OS 설정의 앱별 언어는 API 33+ 에서만 동작한다. API 30~32 의 앱 안 언어 전환은
      AppCompat setApplicationLocales 가 하고, 아래 AppLocalesMetadataHolderService 의
      autoStoreLocales 로 AppCompat 이 직접 저장한다(설계서 §8.2). 그래서 Activity 는 AppCompatActivity 다.
    -->
    <application
        android:name=".SignKoreanApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        tools:targetApi="33">
        <!-- 세로 화면 고정은 요구사항이다 (PRD NFR07). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
