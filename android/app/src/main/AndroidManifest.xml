<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      allowBackup=false 만으로는 Android 12+ 의 기기 간 이전을 막지 못한다. 학습 기록·여행 계획은
      기기 안에만 두므로(PRD §10.4) dataExtractionRules 로 클라우드 백업과 기기 이전을 모두 제외한다.
      localeConfig 는 API 33+ 에서만 쓰이고, 그 아래는 AppCompat 앱별 언어가 맡는다(설계서 §8.2).
    -->
    <application
        android:name=".SignKoreanApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="33">
        <!-- 세로 화면 고정은 요구사항이다 (PRD NFR07). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
