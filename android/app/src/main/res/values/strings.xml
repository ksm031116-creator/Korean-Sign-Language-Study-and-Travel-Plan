<?xml version="1.0" encoding="utf-8"?>
<!-- 기본(영어). 다른 언어 파일에 같은 키가 없으면 Lint MissingTranslation 오류로 빌드가 실패한다. -->
<resources>
    <string name="app_name" translatable="false">Sign Korean</string>
    <string name="app_tagline">Read the city, one sign at a time.</string>

    <!-- 공통 상태 문구 (PRD UX05). 짧고, 사용자가 할 수 있는 다음 행동을 함께 말한다. -->
    <string name="common_saved">Saved</string>
    <string name="common_save_failed">Couldn\'t save that. Try again.</string>
    <string name="common_offline">You\'re offline. Signs you\'ve already opened still work.</string>
    <string name="common_retry">Try again</string>
    <string name="common_undo">Undo</string>
    <string name="common_loading">Loading</string>

    <!-- 형식 (설계서 §8.5). 언어마다 어순이 달라 숫자를 이어 붙이지 않고 자리표시자 하나로 쓴다.
         format_date_short 는 java.time 패턴이다. -->
    <string name="format_date_short">EEE, MMM d</string>
    <string name="format_duration_hm">%1$dh %2$dmin</string>
    <string name="format_duration_h">%1$dh</string>
    <string name="format_duration_m">%1$dmin</string>
    <string name="format_distance_m">%1$d m</string>
    <string name="format_distance_km">%1$s km</string>

    <plurals name="places_count">
        <item quantity="one">%d place</item>
        <item quantity="other">%d places</item>
    </plurals>
</resources>
